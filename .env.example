#######################################
## Local environment — dev profile only
#######################################
## cp .env.example .env   then fill in every blank below.
##
## The blanks are deliberate. A placeholder value here would be a real value in the repo,
## and a blank one is also the only thing GitGuardian has nothing to flag. Every key that
## could read as a credential stays empty on purpose.
##
## .env itself is gitignored. Never commit it.
#######################################
## Required — the app does not start without these
#######################################
DB_URL=jdbc:mysql://localhost:3306/base_app
DB_USERNAME=
DB_PASSWORD=
## Signs the JWTs. Generate one per environment:  openssl rand -base64 32
## Never reuse the same key across environments.
TOKEN_SECRET_KEY=
## Gmail wants an app password here, not the account password.
EMAIL=
EMAIL_PASSWORD=
#######################################
## Required only when running with the dev profile
#######################################
APP_SEED_PASSWORD=
#######################################
## Optional
#######################################
## Defaults live in application.properties, which owns them. Uncomment to
## override for this machine only.
#######################################
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_AUTH=true
# MAIL_CONNECTION_TIMEOUT=5000
# MAIL_TIMEOUT=5000
# MAIL_WRITE_TIMEOUT=5000
# MAIL_TEMPLATE_CACHE=true
# FRONTEND_BASE_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#######################################
## One-shot first admin for an environment that has no ADMIN at all.
## Opt-in. Remove these three once the environment is provisioned.
#######################################
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
